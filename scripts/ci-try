#!/usr/bin/env bash
# ci-try <name> [extra-dir]: push a snapshot of the working tree to the
# throwaway branch ci/try-<name> so GitHub Actions builds it, without touching
# your branch, index or working tree. Then follow the run with:
#   gh run list --branch ci/try-<name> --limit 1
#   gh run watch <id> --exit-status ; gh run view <id> --log-failed
# Delete the branch when you are done:
#   git push origin --delete ci/try-<name>
#
# extra-dir (optional) is a folder outside the repo whose files are added to
# the snapshot at the same relative paths. Use it to try CI against files you
# do not want in the working tree, e.g. a small sample project.
set -euo pipefail
name="${1:?usage: ci-try <name> [extra-dir]}"
extra="${2:-}"
if [[ -n "$extra" ]]; then
  [[ -d "$extra" ]] || { echo "ci-try: $extra is not a folder" >&2; exit 2; }
  extra="$(cd "$extra" && pwd)"
fi
root="$(git rev-parse --show-toplevel)"; cd "$root"
tmp_index="$(mktemp)"; trap 'rm -f "$tmp_index"' EXIT
export GIT_INDEX_FILE="$tmp_index"
git read-tree HEAD
git add -A
if [[ -n "$extra" ]]; then
  while IFS= read -r -d '' file; do
    path="${file#"$extra"/}"
    mode=100644; [[ -x "$file" ]] && mode=100755
    git update-index --add --cacheinfo "$mode,$(git hash-object -w "$file"),$path"
  done < <(find "$extra" -type f ! -name .DS_Store -print0)
fi
tree="$(git write-tree)"
commit="$(git commit-tree "$tree" -p HEAD -m "ci try: $name")"
git push -f origin "$commit:refs/heads/ci/try-$name"
echo "pushed $commit to ci/try-$name"
