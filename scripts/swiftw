#!/usr/bin/env bash
# swiftw: run `swift` so it works both with full Xcode and with only the
# Command Line Tools installed.
#
# With only the Command Line Tools, the newest macOS SDK may need compiler
# plugins that ship only with Xcode (SwiftUI macros). The newest SDK that does
# not need them is used instead.
set -euo pipefail

dev_dir="$(xcode-select -p 2>/dev/null || true)"

if [[ "$dev_dir" == *CommandLineTools* ]]; then
  plugins="$dev_dir/usr/lib/swift/host/plugins"
  if [[ -z "${SDKROOT:-}" && ! -e "$plugins/libSwiftUIMacros.dylib" ]]; then
    best=""
    for sdk in "$dev_dir"/SDKs/MacOSX[0-9]*.sdk; do
      [[ -e "$sdk" ]] || continue
      ver="$(basename "$sdk" .sdk)"; ver="${ver#MacOSX}"; major="${ver%%.*}"
      if (( major < 27 )); then
        if [[ -z "$best" ]] || [[ "$(printf '%s\n%s\n' "$bestver" "$ver" | sort -V | tail -1)" == "$ver" ]]; then
          best="$sdk"; bestver="$ver"
        fi
      fi
    done
    [[ -n "$best" ]] && export SDKROOT="$best"
  fi
fi

exec swift "$@"
