{
  "name": "@open-wisper/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Open Wisper website: one static page, served from Cloudflare.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "WRANGLER_SEND_METRICS=false wrangler dev --ip 127.0.0.1 --port 8788",
    "lint": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:site": "node scripts/check.mjs",
    "deploy": "pnpm run build && WRANGLER_SEND_METRICS=false wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "astro": "7.4.11",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "wrangler": "4.160.1"
  }
}
