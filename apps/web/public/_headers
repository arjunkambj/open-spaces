# Response headers for every file. Cloudflare reads this file; it is not served.
# https://developers.cloudflare.com/workers/static-assets/headers/

# "no-transform" tells Cloudflare to send each file exactly as it was built. Without it,
# a domain with Cloudflare Web Analytics switched on gets a tracking script added to
# every page. This site has no tracking, so nothing may be added.
#
# The Content-Security-Policy lets the page load files from this site only. Scripts are
# this site's own files, plus the few small inline scripts in the prerendered pages, each
# allowed by its exact SHA-256 hash: scripts/finish.mjs writes those hashes in at build
# time, in place of the placeholder in script-src below. No other inline script can run.
/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'self' 'inline-scripts'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Files under /assets/ have a fingerprint of their content in the name, so a browser can
# keep them for a year. Everything else is checked again on each visit.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

# The social preview image is fetched by other sites, so they must be allowed to load it.
/og.png
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
