{
  // The website on Cloudflare: a Worker that only serves the files in dist/.
  // There is no Worker code, so nothing runs per visit.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-wisper-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    // An address that does not exist gets dist/404.html with status 404.
    "not_found_handling": "404-page"
  },
  // A custom domain: Cloudflare makes the DNS record and the certificate itself.
  "routes": [{ "pattern": "whisper.0xhoney.com", "custom_domain": true }],
  // One address only: no *.workers.dev copy and no preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  // Wrangler sends no usage reports.
  "send_metrics": false
}
