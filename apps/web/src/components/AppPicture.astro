---
// A picture of the app that follows light and dark mode, in the sizes and formats a
// browser can choose from. The width and height are set, so the page does not jump.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  /** How wide the picture is shown, as the browser's `sizes` rule. */
  sizes: string;
  /** For the picture at the top of the page: load it at once. */
  first?: boolean;
}

const { light, dark, alt, sizes, first = false } = Astro.props;
const widths = [640, 960, 1280, 1760, 2360].filter((width) => width <= light.width);
const formats = ["avif", "webp"] as const;

const sources = await Promise.all(
  [
    { image: dark, media: "(prefers-color-scheme: dark)" },
    { image: light, media: undefined },
  ].flatMap(({ image, media }) =>
    formats.map(async (format) => ({
      media,
      type: `image/${format}`,
      srcset: (await getImage({ src: image, widths, format })).srcSet.attribute,
    })),
  ),
);
const fallback = await getImage({ src: light, width: Math.min(1280, light.width), format: "png" });
---

<picture>
  {sources.map((source) => <source media={source.media} type={source.type} srcset={source.srcset} sizes={sizes} />)}
  <img
    src={fallback.src}
    width={light.width}
    height={light.height}
    alt={alt}
    loading={first ? "eager" : "lazy"}
    fetchpriority={first ? "high" : undefined}
    decoding="async"
    class="block h-auto w-full"
  />
</picture>
