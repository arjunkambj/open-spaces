---
import { dictation, meetings } from "../content";
import meetingDark from "../images/meeting-dark.png";
import meetingLight from "../images/meeting-light.png";
import AppPicture from "./AppPicture.astro";
---

<section id="features" class="border-t border-stone-900/10 dark:border-white/10">
  <div class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{dictation.title}</h2>
    <p class="mt-3 text-lg text-stone-600 dark:text-stone-300">{dictation.lead}</p>
    <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        dictation.items.map((feature) => (
          <li>
            <h3 class="flex flex-wrap items-center gap-x-3 gap-y-1 text-lg font-semibold tracking-tight">
              {feature.title}
              {feature.keys && (
                <span class="flex gap-1">
                  <span class="sr-only">Keys:</span>
                  {feature.keys.map((key) => (
                    <kbd class="key font-sans">{key}</kbd>
                  ))}
                </span>
              )}
            </h3>
            <p class="mt-2 text-pretty text-stone-600 dark:text-stone-300">{feature.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-24 grid items-center gap-12 sm:mt-32 lg:grid-cols-[5fr_6fr] lg:gap-16">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{meetings.title}</h2>
        <p class="mt-3 text-lg text-stone-600 dark:text-stone-300">{meetings.lead}</p>
        <ul class="mt-8 space-y-6">
          {
            meetings.items.map((feature) => (
              <li>
                <h3 class="text-lg font-semibold tracking-tight">{feature.title}</h3>
                <p class="mt-1 text-pretty text-stone-600 dark:text-stone-300">{feature.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="window">
        <AppPicture
          light={meetingLight}
          dark={meetingDark}
          alt={meetings.pictureAlt}
          sizes="(min-width: 1152px) 560px, (min-width: 1024px) 50vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </div>
</section>
