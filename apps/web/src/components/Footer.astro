---
import { footer } from "../content";
import Brand from "./Brand.astro";
---

<footer class="border-t border-stone-900/10 dark:border-white/10">
  <div class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-wrap items-center justify-between gap-x-10 gap-y-6">
      <Brand />
      <ul class="flex flex-wrap gap-x-7 gap-y-2 text-[15px]">
        {
          footer.links.map((link) => (
            <li>
              <a href={link.href} class="text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="mt-8 max-w-2xl text-sm text-pretty text-stone-600 dark:text-stone-400">{footer.independent}</p>
    <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">{footer.pictures}</p>
  </div>
</footer>
