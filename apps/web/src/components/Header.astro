---
import { links, nav } from "../content";
import Brand from "./Brand.astro";
import DownloadButton from "./DownloadButton.astro";
---

<header class="sticky top-0 z-10 border-b border-stone-900/10 bg-stone-50/85 backdrop-blur-md dark:border-white/10 dark:bg-stone-950/85">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-6 px-5 sm:px-8">
    <Brand />
    <nav aria-label="Main" class="flex items-center gap-6 text-[15px]">
      {
        nav.map((item) => (
          <a href={item.href} class="hidden text-stone-600 hover:text-stone-900 sm:block dark:text-stone-300 dark:hover:text-white">
            {item.label}
          </a>
        ))
      }
      <a href={links.repo} class="text-stone-600 hover:text-stone-900 dark:text-stone-300 dark:hover:text-white">GitHub</a>
      <DownloadButton size="small" />
    </nav>
  </div>
</header>
