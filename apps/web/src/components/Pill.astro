---
// A drawing of the floating pill while it listens: a dark capsule with a moving waveform.
// The bars are styled in src/styles/global.css (.wave). They stand still for people who
// ask their system for less motion.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div
  role="img"
  aria-label={label}
  class="wave inline-flex h-9 items-center gap-[3px] rounded-full bg-stone-900 px-5 shadow-lg ring-1 shadow-stone-900/20 ring-white/15"
>
  {Array.from({ length: 11 }, () => <span />)}
</div>
