---
import { privacy } from "../content";
---

<section id="privacy" class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
  <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{privacy.title}</h2>
  <p class="mt-3 text-lg text-stone-600 dark:text-stone-300">{privacy.lead}</p>

  <div class="mt-12 grid gap-12 lg:grid-cols-[6fr_5fr] lg:gap-16">
    <ul class="grid content-start gap-x-10 gap-y-10 sm:grid-cols-2">
      {
        privacy.items.map((item) => (
          <li>
            <h3 class="text-lg font-semibold tracking-tight">{item.title}</h3>
            <p class="mt-2 text-pretty text-stone-600 dark:text-stone-300">{item.text}</p>
          </li>
        ))
      }
    </ul>

    <!-- The one thing set apart on the page: the honest list of what is sent. -->
    <div class="rounded-2xl border border-stone-900/15 p-6 sm:p-8 dark:border-white/15">
      <h3 class="text-lg font-semibold tracking-tight">{privacy.sentTitle}</h3>
      <ul class="mt-4 space-y-2.5 text-stone-700 dark:text-stone-200">
        {
          privacy.sent.map((line) => (
            <li class="flex gap-3">
              <span class="bg-pine dark:bg-pine-bright mt-[0.6em] size-1.5 shrink-0 rounded-full" aria-hidden="true" />
              {line}
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-pretty text-stone-600 dark:text-stone-300">{privacy.sentWhere}</p>
      <p class="mt-3 text-sm text-pretty text-stone-600 dark:text-stone-400">{privacy.updates}</p>
    </div>
  </div>
  <p class="mt-12 text-sm text-stone-600 dark:text-stone-400">{privacy.thisPage}</p>
</section>
