---
// The app icon and the name. The icon is the app's own, from assets/ at the repo root.
import { Image } from "astro:assets";
import appIcon from "../../../../assets/icon-1024.png";
import { site } from "../content";
---

<a href="/" class="flex items-center gap-2">
  <Image src={appIcon} alt="" width={32} height={32} densities={[1, 2, 3]} loading="eager" class="size-8" />
  <span class="font-rounded text-[17px] font-semibold tracking-tight">{site.name}</span>
</a>
