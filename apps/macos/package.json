{
  "name": "@open-spaces/macos",
  "version": "0.1.2",
  "private": true,
  "description": "Spaces for macOS.",
  "scripts": {
    "build": "../../scripts/swiftw build",
    "lint": "swift format lint --strict --recursive --parallel Package.swift Sources",
    "bundle": "./scripts/bundle",
    "dmg": "./scripts/bundle && ./scripts/dmg",
    "dev": "./scripts/bundle && open 'build/Spaces.app'"
  },
  "dependencies": {
    "@open-spaces/domain": "workspace:*",
    "@open-spaces/store": "workspace:*",
    "@open-spaces/ai": "workspace:*",
    "@open-spaces/audio": "workspace:*",
    "@open-spaces/engine": "workspace:*",
    "@open-spaces/ui": "workspace:*",
    "@open-spaces/agent": "workspace:*"
  }
}
