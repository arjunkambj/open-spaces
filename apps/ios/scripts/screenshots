#!/usr/bin/env bash
# screenshots [output-dir]: take pictures of the real app in an iPhone simulator.
#
# Needs the app to be built first (`scripts/ios build`). Boots a simulator, installs the
# app, opens it in demo mode once per scene, and saves one PNG per scene in light mode, plus
# the main ones in dark mode and with very large text. The demo runs on made-up data in
# memory: no microphone, no network, no files.
#
#   IOS_DESTINATION   the simulator, as for scripts/ios (default: the newest iPhone)
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="${1:-$here/build/screenshots}"
bundle_id="dev.openwisper.ios"
scenes=(
  first-run dictate dictate-empty dictate-recording dictate-working dictate-result dictate-failed
  dictate-nothing-heard dictate-no-key dictate-no-microphone meetings meeting history library keyboard
  settings link-question
)
# Each picture takes about ten seconds, so dark mode and large text get the scenes that matter most.
dark_scenes=(first-run dictate-result dictate-recording meetings meeting history library keyboard settings)
large_scenes=(dictate-result dictate-recording dictate-no-key library keyboard)

app="$(find "$here/build/DerivedData/Build/Products" -maxdepth 2 -name 'OpenWisper.app' -path '*iphonesimulator*' | head -1)"
[[ -n "$app" ]] || { echo "error: no simulator build of the app. Run scripts/ios build first." >&2; exit 1; }

udid="$(sed -nE 's/.*id=([0-9A-Fa-f-]{36}).*/\1/p' <<<"${IOS_DESTINATION:-}")"
if [[ -z "$udid" ]]; then
  udid="$(xcrun simctl list devices available \
    | sed -nE 's/^ +iPhone[^(]*\(([0-9A-Fa-f-]{36})\).*/\1/p' | tail -1)"
fi
[[ -n "$udid" ]] || { echo "error: no iPhone simulator is installed." >&2; exit 1; }

mkdir -p "$out"
xcrun simctl bootstatus "$udid" -b >/dev/null
xcrun simctl install "$udid" "$app"
# A tidy status bar: 9:41, full battery, full signal.
xcrun simctl status_bar "$udid" override --time "9:41" --batteryState charged --batteryLevel 100 \
  --cellularBars 4 --wifiBars 3 >/dev/null 2>&1 || true

# shoot <scene> <file name>: opens the app in one scene and saves a picture of it.
shoot() {
  xcrun simctl terminate "$udid" "$bundle_id" >/dev/null 2>&1 || true
  xcrun simctl launch "$udid" "$bundle_id" --scene "$1" >/dev/null
  # Time for the launch animation and for the scene to settle.
  sleep 3
  xcrun simctl io "$udid" screenshot --type=png "$out/$2.png" >/dev/null 2>&1
  echo "$out/$2.png"
}

xcrun simctl ui "$udid" appearance light
for scene in "${scenes[@]}"; do shoot "$scene" "$scene-light"; done

xcrun simctl ui "$udid" appearance dark
for scene in "${dark_scenes[@]}"; do shoot "$scene" "$scene-dark"; done

# Once more with very large text, to see that nothing is cut off or overlaps.
xcrun simctl ui "$udid" appearance light
if xcrun simctl ui "$udid" content_size accessibility-large >/dev/null 2>&1; then
  for scene in "${large_scenes[@]}"; do shoot "$scene" "$scene-large-text"; done
  xcrun simctl ui "$udid" content_size large >/dev/null 2>&1 || true
fi

xcrun simctl terminate "$udid" "$bundle_id" >/dev/null 2>&1 || true
xcrun simctl status_bar "$udid" clear >/dev/null 2>&1 || true
