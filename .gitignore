# macOS
.DS_Store

# Node tooling (pnpm, Turbo)
node_modules/
.turbo/

# The website (apps/web): files Astro and Wrangler make while they work
.astro/
.wrangler/

# Swift builds
.build/
.build-*/
.swiftpm/
Package.resolved
# The Mac app has one outside library, the updater. Its exact version is kept.
!/apps/macos/Package.resolved

# Xcode. The iOS project is made from apps/ios/project.yml by XcodeGen.
DerivedData/
*.xcodeproj
*.xcworkspace
xcuserdata/
*.xcuserstate
*.xcresult

# Things the scripts make: app bundles, zips, logs
build/
dist/
ios-logs/

# Local settings and secrets. An API key never belongs in the repo, and neither does a
# signing key: scripts/setup-signing keeps those in ~/.config/open-wisper/signing.
.env
.env.*
*.local
*.p12
*.keychain-db
