{
  "name": "open-spaces",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source voice dictation and meeting notes for macOS. Local-first, bring your own OpenAI key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunkambj/open-spaces.git"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "scripts/turbow run build",
    "lint": "scripts/turbow run lint",
    "check": "scripts/turbow run lint build",
    "format": "swift format format --in-place --recursive --parallel apps packages",
    "mac": "pnpm --filter @open-spaces/macos run dev",
    "mac:bundle": "pnpm --filter @open-spaces/macos run bundle",
    "mac:dmg": "pnpm --filter @open-spaces/macos run dmg",
    "web": "pnpm --filter @open-spaces/web run dev",
    "web:build": "pnpm --filter @open-spaces/web run build",
    "web:deploy": "pnpm --filter @open-spaces/web run deploy"
  },
  "devDependencies": {
    "turbo": "2.11.11"
  }
}
