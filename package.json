{
  "name": "open-wisper",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source voice dictation and meeting notes for macOS and iOS. Local-first, bring your own OpenAI key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arjunkambj/open-wisper.git"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "scripts/turbow run build",
    "test": "scripts/turbow run test",
    "lint": "scripts/turbow run lint",
    "check": "scripts/turbow run lint build test",
    "format": "swift format format --in-place --recursive --parallel apps packages",
    "mac": "pnpm --filter @open-wisper/macos run dev",
    "mac:bundle": "pnpm --filter @open-wisper/macos run bundle",
    "mac:dmg": "pnpm --filter @open-wisper/macos run dmg",
    "ios:generate": "scripts/ios generate",
    "ios:build": "scripts/ios build",
    "ios:test": "scripts/ios test"
  },
  "devDependencies": {
    "turbo": "2.11.11"
  }
}
