{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["scripts/swiftw", ".swift-format"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["Package.swift", "Sources/**", "Resources/**", "project.yml"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["Package.swift", "Sources/**", "Tests/**"],
      "outputs": []
    },
    "lint": {
      "inputs": ["Package.swift", "Sources/**", "Tests/**", "App/**", "Keyboard/**"],
      "outputs": []
    },
    "bundle": { "dependsOn": ["build"], "cache": false },
    "dev": { "cache": false, "persistent": true },
    "generate": { "cache": false }
  }
}
