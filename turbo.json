{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "concurrency": "2",
  "globalDependencies": [
    "scripts/swiftw",
    ".swift-format"
  ],
  "globalEnv": [
    "SPACES_TOOLCHAIN",
    "DEVELOPER_DIR",
    "SDKROOT",
    "TOOLCHAINS"
  ],
  "globalPassThroughEnv": [
    "CI",
    "GITHUB_ACTIONS",
    "TMPDIR"
  ],
  "tasks": {
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md"
      ],
      "outputs": []
    },
    "@open-spaces/web#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/assets/icon-1024.png",
        "$TURBO_ROOT$/apps/macos/package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "bundle": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
