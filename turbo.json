{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "concurrency": "2",
  "globalDependencies": ["scripts/swiftw", "scripts/ios", ".swift-format"],
  "globalEnv": ["WISPER_TOOLCHAIN", "DEVELOPER_DIR", "SDKROOT", "TOOLCHAINS"],
  "globalPassThroughEnv": [
    "CI",
    "GITHUB_ACTIONS",
    "TMPDIR",
    "IOS_SKIP",
    "IOS_SCHEME",
    "IOS_DESTINATION",
    "IOS_LOG_DIR"
  ],
  "tasks": {
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!Tests/**", "!**/*.md"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": []
    },
    "@open-wisper/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "$TURBO_ROOT$/assets/icon-1024.png",
        "$TURBO_ROOT$/apps/macos/package.json"
      ],
      "outputs": ["dist/**"]
    },
    "@open-wisper/ios#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@open-wisper/ios#test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bundle": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "generate": {
      "cache": false
    }
  }
}
