# Text files use LF line endings everywhere, so shell scripts keep working.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.icns binary
*.ico binary
*.pdf binary
*.m4a binary
*.wav binary
*.mp3 binary
*.caf binary
*.aiff binary
*.zip binary

# Written by a tool. GitHub folds it in diffs and leaves it out of language stats.
pnpm-lock.yaml linguist-generated=true
