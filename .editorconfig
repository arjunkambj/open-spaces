# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
max_line_length = 110

# Two spaces at the end of a line mean a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
